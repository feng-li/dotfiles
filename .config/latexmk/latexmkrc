

# Serialize complete build cycles across projects, including bibliography and
# PDF conversion. Release between -pvc cycles so idle watchers do not block.
{
    package LatexmkCompileLock;
    use Fcntl qw(:flock O_CREAT O_RDWR F_SETFD);
    use File::Path qw(make_path);
    our ($handle, $held, $installed);

    sub acquire {
        return 0 if $held;
        unless ($handle) {
            my $cache = $ENV{XDG_CACHE_HOME} || "$ENV{HOME}/.cache";
            my $directory = "$cache/latexmk";
            make_path($directory, { mode => 0700 }) unless -d $directory;
            sysopen($handle, "$directory/compile.lock", O_CREAT | O_RDWR, 0600)
                or die "Cannot open latexmk compile lock: $!\n";
            # A compiler child retains protection if its parent is killed.
            fcntl($handle, F_SETFD, 0)
                or die "Cannot configure latexmk compile lock: $!\n";
        }
        unless (flock($handle, LOCK_EX | LOCK_NB)) {
            print "Latexmk: waiting for the global compile lock...\n";
            flock($handle, LOCK_EX)
                or die "Cannot acquire latexmk compile lock: $!\n";
        }
        $held = 1;
        return 0;
    }

    sub release {
        if ($held) {
            flock($handle, LOCK_UN)
                or die "Cannot release latexmk compile lock: $!\n";
            $held = 0;
        }
        return 0;
    }

    sub close_handle {
        # Close rather than unlock on exit: a still-running compiler child
        # must retain protection until it exits too.
        close($handle) if $handle;
        undef $handle;
        $held = 0;
    }
}

# Protect startup cache operations and each subsequent compilation. Wrapping
# rdb_make is necessary because compile_end is not called on failed -pvc
# cycles in latexmk 4.88, or on ordinary non-watcher builds.
LatexmkCompileLock::acquire();
unless ($LatexmkCompileLock::installed) {
    defined(&rdb_make) or die "latexmk does not expose its build-cycle routine\n";
    my $original_make = \&rdb_make;
    no warnings 'redefine';
    *rdb_make = sub {
        LatexmkCompileLock::acquire();
        my $result;
        my $ok = eval { $result = $original_make->(@_); 1 };
        my $error = $@;
        unless ($ok) {
            LatexmkCompileLock::close_handle();
            die $error;
        }
        LatexmkCompileLock::release();
        return $result;
    };
    $LatexmkCompileLock::installed = 1;
}
END { LatexmkCompileLock::close_handle(); }

$latex = 'latex -file-line-error -synctex=1 %O %S';

# Keep engine selection explicit: -pdf uses pdfLaTeX, -xelatex uses XeLaTeX.
$pdflatex = 'pdflatex -file-line-error -synctex=1 %O %S';
$xelatex  = 'xelatex -file-line-error -synctex=1 %O %S';

$latex_silent_switch   = "-interaction=batchmode";
$xelatex_silent_switch = "-interaction=batchmode";

$pdf_mode = 5; # XeLaTeX;

$pdf_previewer = 'xdg-open %O %S';

$bibtex_use = 2;


# --------------------------------------------------
# Build in RAM
# --------------------------------------------------

use Sys::Hostname;
use Cwd qw(abs_path);
use Digest::MD5 qw(md5_hex);
use File::Copy qw(copy);
use File::Path qw(make_path);
use File::Basename qw(basename);

my $project  = abs_path('.');
my $hash     = md5_hex($project);
my $ramdir   = "/dev/shm/latexmk-$ENV{USER}/$hash";

# --------------------------------------------------
# Configurable variables
# --------------------------------------------------
my @figdirs = qw(
    figures
    pictures
    figs
);

my $texmfbibdir = "$ENV{HOME}/texmf/bibtex/bib";

my @bibfiles = (
    glob("$texmfbibdir/*.bib"),
    glob("*.bib"),
);


# --------------------------------------------------
# Cache texmf bibliography files in RAM
# --------------------------------------------------

my %bibfiles;

# Make and Protect the ram folder
make_path($ramdir, { mode => 0700 }) unless -d $ramdir;

# TeXMF files first
foreach my $src (glob("$texmfbibdir/*.bib")) {
    $bibfiles{basename($src)} = $src;
}

# Project-local files override TeXMF files
foreach my $src (glob("*.bib")) {
    $bibfiles{basename($src)} = $src;
}

foreach my $bib (keys %bibfiles) {
    my $src = $bibfiles{$bib};
    my $dst = "$ramdir/$bib";

    if (!-e $dst || (stat($src))[9] > (stat($dst))[9]) {
        print "Latexmk: caching $src -> $dst\n";

        copy($src, $dst)
            or die "Cannot copy $src to $dst: $!";

        my @st = stat($src);
        utime($st[8], $st[9], $dst);
    }
}

# --------------------------------------------------
# Cache figures/ folder in RAM
# --------------------------------------------------

# Cache figures into ram

foreach my $dir (@figdirs) {
    if (-d $dir) {
        system(
            "rsync", "-av", "--delete",
            "$dir/", "$ramdir/$dir/"
        );
    }
}

# --------------------------------------------------
# AUX, OUT files in RAM
# --------------------------------------------------
# Keep auxiliary files in RAM and final output beside the source. XeLaTeX's
# image conversion must resolve relative figure paths from the project.
$aux_dir = $ramdir;
$out_dir = '.';

# Only final PDF/synctex are copied back after latexmk has converged
$out2_dir = '.';

# Resolve relative bibliography paths from the project, not the aux directory.
$bibtex_fudge = 0;
